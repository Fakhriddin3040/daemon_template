# ===== APP =====
APP_ENVIRONMENT=development
APP_TIMEZONE=UTC

# python scripts/utils/generate_secret.py
APP_SECRET_KEY=

# base64-encoded 32 bytes, same generator
APP_AES_KEY=YhgBkRewkHatAc4rYM7iRTyPOVM8VY5FXr8B8aaTg0u0oD3vRR

# ===== POSTGRES =====
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost

# Exposed port
POSTGRES_PORT=5432

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== TELEMETRY =====
# Which process wrote a record; each container overrides it.
TELEMETRY_SERVICE=app
TELEMETRY_LOG_DIR=logs
# seconds
TELEMETRY_POLL_INTERVAL=0.5
TELEMETRY_FROM_END=true
TELEMETRY_MIN_LEVEL=INFO
TELEMETRY_TELEGRAM_MIN_LEVEL=ERROR
TELEMETRY_EXCLUDE_URL_PREFIXES=
TELEMETRY_POSTGRES_ENABLED=true
TELEMETRY_TELEGRAM_ENABLED=false
TELEMETRY_POSTGRES_BATCH_SIZE=200

# ===== TELEGRAM (telemetry alerts; optional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SYSTEM_CHAT_ID=

# ===== COMPOSE =====
COMPOSE_PROJECT_NAME=app_template
